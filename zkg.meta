[package]
description = Logs the connections that Zeek's core conn.log does not record:
  non-TCP/UDP/ICMP IP traffic (any IP protocol other than 1, 6, 17 and 58)
  and pure L2 / non-IP Ethernet frames. Frames are aggregated into
  bidirectional flows and written to other_conn.log using conn.log-style
  column naming, extended with L2 telemetry (MAC addresses, VLAN, eth_type)
  and the numeric L3 protocol number.
tags = conn, logging, layer2, ethernet, vlan, non-ip, flow
script_dir = scripts
test_command = cd tests && btest -c btest.cfg
